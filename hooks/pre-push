#!/usr/bin/env sh
# Heavier gate before code leaves the laptop.
set -e

# Auto-bump VERSION based on conventional commits since the last v* tag.
# Skipped if VERSION file is absent or SKIP_VERSION_BUMP=1 in the env.
if [ -f VERSION ] && [ -f scripts/bump-version.sh ] && [ -z "${SKIP_VERSION_BUMP:-}" ]; then
  bash scripts/bump-version.sh || {
    echo "Version bump failed — push aborted." >&2
    exit 1
  }
fi

if [ -f package.json ]; then
  pnpm verify
fi

if [ -f .pre-commit-config.yaml ]; then
  pre-commit run --hook-stage push
fi

# iOS check (host only — CI handles this on macos-latest)
if [ -f scripts/ios-test.sh ] && [ "$(uname -s)" = "Darwin" ]; then
  scripts/ios-test.sh --quick || {
    echo "iOS quick tests failed — push aborted." >&2
    exit 1
  }
fi
